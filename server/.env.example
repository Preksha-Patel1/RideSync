PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/ride-hailing
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
# Radius (in meters) used by the driver-matching geospatial query
DRIVER_SEARCH_RADIUS_METERS=5000
# Redis connection string (cache + fast-changing driver state)
REDIS_URL=redis://localhost:6379
# TTL (seconds) for cached driver status entries
REDIS_DRIVER_TTL_SECONDS=30
# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092
# Client id this app identifies itself with to the Kafka broker
KAFKA_CLIENT_ID=ridesync-backend
# TTL (seconds) for a ride's live driver-location cache (Socket.IO -> Redis)
REDIS_RIDE_LOCATION_TTL_SECONDS=120
# Simulated fare formula: fare = FARE_BASE + distanceKm*FARE_PER_KM + durationMinutes*FARE_PER_MINUTE
FARE_BASE=50
FARE_PER_KM=15
FARE_PER_MINUTE=2
# Currency used for simulated payments
PAYMENT_CURRENCY=INR
